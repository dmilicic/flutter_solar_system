{
  "rules": {
    "spaceships": {
      "$batch_id": {
        ".read": "true",
        "$spaceship_id": {
          ".write": "true",
          ".validate": "newData.hasChildren(['id', 'name', 'locationX', 'locationY', 'lastUpdated'])"
        }
      }
    },
    "currentSpaceshipBatch": {
      ".read": "true",
      ".write": "true",
      ".validate": "newData.hasChildren(['index', 'count'])"
    }
  }
}